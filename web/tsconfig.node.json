{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsc/node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/node.tsbuildinfo",
    "rootDir": "..",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "paths": {
      "@shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "../packages/app/src/theme/vite-plugin.ts",
    "../packages/app/src/theme/bootstrap.ts",
    "../packages/shared/src/constants.ts",
    "../packages/shared/src/types.ts",
    "../packages/shared/src/types-base.ts",
    "../packages/shared/src/types-extra.ts",
    "pwa.config.ts"
  ]
}
