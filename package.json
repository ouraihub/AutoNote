{
  "name": "autonote",
  "private": true,
  "license": "LGPL-3.0-only",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "web:dev": "pnpm --filter autonote-web dev",
    "web:check": "pnpm --filter autonote-web typecheck && pnpm --filter @autonote/shared typecheck",
    "web:test": "pnpm --filter @autonote/shared test && pnpm --filter autonote-web test:unit",
    "web:build": "pnpm --filter autonote-web build",
    "desktop:dev": "pnpm --filter autonote-desktop dev:app",
    "desktop:verify": "pnpm --filter autonote-desktop verify"
  }
}
