{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: Aether features and HTTP(S) browser links. File and secret access stay in Rust.",
  "windows": ["main"],
  "permissions": [
    "core:default", "aether:providers", "aether:chat", "aether:chat-history", "aether:search",
    "aether:skills", "aether:mcp-client",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }
  ]
}
