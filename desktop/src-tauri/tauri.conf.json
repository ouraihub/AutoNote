{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoNote",
  "version": "0.2.1",
  "identifier": "com.autonote.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build",
    "windows": { "staticVCRuntime": true }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AutoNote",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://autonote-file.localhost autonote-file:; media-src 'self' blob: http://autonote-file.localhost autonote-file:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "nsis-hooks.nsh" }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
