{
  "name": "autonote-desktop",
  "version": "0.2.1",
  "description": "AutoNote Desktop: Tauri 2 + Svelte 5 local-first Markdown notebook.",
  "private": true,
  "license": "LGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "check:rust": "node scripts/cargo.mjs check --workspace --all-targets",
    "test:rust": "node scripts/cargo.mjs test --workspace",
    "clippy": "node scripts/cargo.mjs clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "node scripts/cargo.mjs fmt --all -- --check",
    "fmt:rust:fix": "node scripts/cargo.mjs fmt --all",
    "dev:app": "node scripts/app.mjs dev",
    "build:app": "node scripts/app.mjs build",
    "smoke:app": "node scripts/smoke-app.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "package:verify": "node scripts/package-verify.mjs",
    "test:secrets": "node scripts/test-secrets.mjs",
    "test:release": "node scripts/release-artifacts.test.mjs && node scripts/release-gate.test.mjs && node scripts/release-candidates.test.mjs",
    "clean": "node scripts/app.mjs clean",
    "verify": "pnpm run check && pnpm run check:rust && pnpm run test && pnpm run test:release && pnpm run test:rust && pnpm run test:secrets && pnpm run clippy && pnpm run fmt:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@autonote/app": "workspace:*",
    "@ouraihub/aether-ui": "github:ouraihub/Aether#b86431bd259c628f84f09fd29b6d472c71cf88fa&path:packages/ui",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.13.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  }
}
