{
  "name": "autonote-desktop",
  "version": "0.2.8",
  "description": "AutoNote Desktop: Tauri 2 + Svelte 5 local-first Markdown notebook.",
  "private": true,
  "license": "LGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "test:rust": "desktop-kit cargo test --workspace",
    "clippy": "desktop-kit cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "desktop-kit cargo fmt --all -- --check",
    "fmt:rust:fix": "desktop-kit cargo fmt --all",
    "dev:app": "desktop-kit dev",
    "build:app": "desktop-kit build",
    "smoke:native": "node scripts/smoke-native.mjs",
    "package:verify": "node scripts/package-verify.mjs",
    "test:secrets": "node scripts/test-secrets.mjs",
    "clean": "desktop-kit clean",
    "test:release": "desktop-kit self-test",
    "verify": "pnpm run check && pnpm run test && pnpm run test:release && pnpm run test:rust && pnpm run test:secrets && pnpm run clippy && pnpm run fmt:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@autonote/app": "workspace:*",
    "@ouraihub/aether-ui": "github:ouraihub/Aether#53b80630bdd58f22ca94d119e93586f84fbceec7&path:packages/ui",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@ouraihub/desktop-kit": "github:ouraihub/desktop-kit#83889a82abbbf99c6e1fc3cc46ef4942ac37dc5f",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.13.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  },
  "desktopKit": {
    "platforms": [
      "windows",
      "macos",
      "linux"
    ],
    "tagPrefix": "desktop-v",
    "forbidTauriVersion": true,
    "portable": {
      "files": [
        "../LICENSE"
      ]
    },
    "release": {
      "repo": "OurAIApps/AutoNote",
      "title": "AutoNote Desktop {version}",
      "notes": "release-notes.md",
      "workflow": ".github/workflows/desktop.yml"
    }
  }
}
